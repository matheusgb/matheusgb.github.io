---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/topicos/{{ tag | downcase }}/"
layout: default
---

# Posts sobre: {{ tag | capitalize | strip }}

<div class="mb-6">
  <a href="/topicos" id="back-link" class="text-white hover:text-gray-300 no-underline">← Voltar para Tópicos</a>
</div>

{% assign posts = collections[tag] %}
{% assign reversedPosts = posts | reverse %}

<!-- Paginação simples: máximo 10 posts por página -->
{% assign maxPosts = 10 %}
{% assign totalPosts = reversedPosts.size %}
{% assign hasMorePosts = totalPosts > maxPosts %}

{% for post in reversedPosts limit: maxPosts %}
  {% if post.data.published != false %}
    <div class="py-6 px-6 mb-6 bg-gray-800 bg-opacity-50 rounded-lg">
      <p class="mb-1">
        <span class="text-2xl sm:text-4xl font-bold text-white leading-tight">
          <a href="{{ post.url }}" class="hover:text-gray-300 no-underline">{{ post.data.title }}</a>
        </span>
      </p>
      <em class="text-base text-gray-300 block mb-4">{{ post.date | dateDisplay }}</em>
      {% if post.data.post_excerpt %}
        <p class="text-lg text-white">{{ post.data.post_excerpt }}</p>
      {% endif %}
      
      {% if post.data.tags %}
        <div class="mt-4">
          <div class="flex flex-wrap">
            {% for postTag in post.data.tags %}
              {% unless postTag == "posts" %}
                <a href="/topicos/{{ postTag | downcase | strip }}" 
                   class="inline-block bg-gray-700 text-gray-300 px-2 py-1 rounded text-sm hover:bg-gray-600 transition-colors mr-2 mb-1">
                  {{ postTag | strip }}
                </a>
              {% endunless %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  {% endif %}
{% endfor %}

{% if hasMorePosts %}
  <div class="text-center mt-8">
    <p class="text-gray-400">Mostrando {{ maxPosts }} de {{ totalPosts }} posts</p>
  </div>
{% endif %}

{% if posts.size == 0 %}
  <p class="text-gray-400 italic">Nenhum post encontrado para este tópico.</p>
{% endif %}

<!-- Botões de paginação -->
<nav class="flex justify-center mt-8">
    <div class="inline-flex">
      <button class="paginator-text cursor-not-allowed">
        Início
      </button>
      
      <button class="py-2 px-4 cursor-not-allowed">
        <img src="/assets/img/chevron-left-disabled.svg" alt="prev">
      </button>

      <button class="border bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4" aria-current="page">
        1
      </button>

      <button class="py-2 px-4 cursor-not-allowed">
        <img src="/assets/img/chevron-right-disabled.svg" alt="next">
      </button>

      <button class="paginator-text cursor-not-allowed">
        Fim
      </button>
    </div>
</nav>

<!-- Espaçamento igual ao do topo do site -->
<div class="pb-10 md:pb-20"></div>