<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8">
  	<meta name='viewport' content='width=device-width'>
    
    <!-- Security Headers (only ones that work in meta tags) -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin">
    
    <!-- Otimizações de rendering -->
    <meta name="color-scheme" content="dark">
    <meta name="format-detection" content="telephone=no">

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FR0EREBNL3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-FR0EREBNL3');
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/assets/img/blog.png">
    <link rel="shortcut icon" type="image/png" href="/assets/img/blog.png">

    <title>{{ site.title }}</title>
    <meta name='description' content={{ site.description }}>
    <meta name="theme-color" content="#1c1c1c"/>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="{% if title and date %}article{% else %}website{% endif %}">
    <meta property="og:url" content="{{ site.url }}{% if page.url %}{{ page.url }}{% else %}/{% endif %}">
    <meta property="og:title" content="{% if title and title != site.title %}{{ title }} - {{ site.title }}{% else %}{{ site.title }}{% endif %}">
    <meta property="og:description" content="{% if post_excerpt %}{{ post_excerpt }}{% elsif description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
    <meta property="og:image" content="{{ site.url }}/assets/img/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:locale" content="pt_BR">
    {% if title and date %}
    <meta property="article:author" content="{{ site.name }}">
    <meta property="article:published_time" content="{{ date | date: '%Y-%m-%d' }}">
    <meta property="article:section" content="Blog">
    {% endif %}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="{{ site.url }}{% if page.url %}{{ page.url }}{% else %}/{% endif %}">
    <meta name="twitter:title" content="{% if title and title != site.title %}{{ title }} - {{ site.title }}{% else %}{{ site.title }}{% endif %}">
    <meta name="twitter:description" content="{% if post_excerpt %}{{ post_excerpt }}{% elsif description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
    <meta name="twitter:image" content="{{ site.url }}/assets/img/og-image.png">
    <meta name="twitter:creator" content="@matheusgb">
    <meta name="twitter:site" content="@matheusgb">

    <!-- Meta tags adicionais -->
    <meta name="author" content="{{ site.name }}">
    <meta name="robots" content="index, follow">
    <meta name="generator" content="Eleventy v3.1.2">
    <meta name="language" content="pt-BR">
    <link rel="canonical" href="{{ site.url }}{% if page.url %}{{ page.url }}{% else %}/{% endif %}">

    <!-- Structured Data (JSON-LD) for SEO -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "{% if title and date %}BlogPosting{% else %}Blog{% endif %}",
      "name": "{% if title and title != site.title %}{{ title }}{% else %}{{ site.title }}{% endif %}",
      "headline": "{% if title and title != site.title %}{{ title }}{% else %}{{ site.title }}{% endif %}",
      "description": "{% if post_excerpt %}{{ post_excerpt }}{% elsif description %}{{ description }}{% else %}{{ site.description }}{% endif %}",
      "url": "{{ site.url }}{% if page.url %}{{ page.url }}{% else %}/{% endif %}",
      "author": {
        "@type": "Person",
        "name": "{{ site.name }}",
        "url": "{{ site.url }}"
      },
      "publisher": {
        "@type": "Person",
        "name": "{{ site.name }}",
        "url": "{{ site.url }}"
      }{% if date %},
      "datePublished": "{{ date | date: '%Y-%m-%d' }}",
      "dateModified": "{{ date | date: '%Y-%m-%d' }}"{% endif %}
    }
    </script>

    <link rel="manifest" href="/manifest.json" />

    <!-- Performance optimizations -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">
    <link rel="dns-prefetch" href="https://unpkg.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Critical resources preload -->
    <link rel="preload" href="/assets/img/top-img.webp" as="image" type="image/webp" fetchpriority="high">
    <link rel="preload" href="/assets/styles/tailwind.css" as="style">
    <link rel="preload" href="/assets/styles/index.css" as="style">

    <!-- Stylesheets in order of importance -->
    <link href="https://unpkg.com/prismjs@1.20.0/themes/prism-okaidia.css" rel="stylesheet" media="print" onload="this.media='all'">
    <link href="/assets/styles/tailwind.css" rel="stylesheet" />
    <link href="/assets/styles/index.css" rel="stylesheet" />
    <script>
      document.documentElement.classList.add('dark');
      localStorage.theme = 'dark';
      
      // Processa código inline
      function processInlineCode() {
        const contentArea = document.querySelector('.prose') || document.querySelector('main') || document.body;
        
        if (contentArea) {
          // Processa elementos <code> existentes
          const codeElements = contentArea.querySelectorAll('code:not(pre code)');
          codeElements.forEach((codeEl) => {
            codeEl.classList.add('inline-code');
            codeEl.style.setProperty('content', 'none', 'important');
          });
          
          // Processa texto com crases nos excerpts (página index)
          const excerptElements = contentArea.querySelectorAll('p');
          excerptElements.forEach((p) => {
            if (p.innerHTML.includes('`')) {
              p.innerHTML = p.innerHTML.replace(/`([^`]+)`/g, '<code class="inline-code">$1</code>');
            }
          });
        }
      }
      
      document.addEventListener('DOMContentLoaded', processInlineCode);
    </script>
    
    <!-- Barba.js para navegação SPA -->
    <script src="https://unpkg.com/@barba/core"></script>
    <script>
      // Função para configurar link de volta
      function setupBackLink() {
        const backLink = document.getElementById('back-link');
        if (backLink) {
          const previousPage = sessionStorage.getItem('previousPage');
          const referrer = document.referrer;
          
          // Prioriza sessionStorage (navegação via Barba.js)
          let origin = previousPage;
          
          // Se não há sessionStorage, usa referrer (primeiro acesso)
          if (!origin && referrer) {
            const referrerUrl = new URL(referrer);
            origin = referrerUrl.pathname;
          }
          
          
          if (origin === '/' || origin === '/index.html') {
            backLink.href = '/';
            backLink.innerHTML = '← Voltar para Posts';
          } else if (origin === '/topicos' || origin === '/topicos/') {
            backLink.href = '/topicos';
            backLink.innerHTML = '← Voltar para Tópicos';
          } else {
            // Padrão se não conseguir detectar
            backLink.href = '/topicos';
            backLink.innerHTML = '← Voltar para Tópicos';
          }
        }
      }
      
      // Inicialização após DOM estar pronto
      document.addEventListener('DOMContentLoaded', function() {
        // Configura link de volta na primeira carga
        setupBackLink();
        
        // Inicializa Barba.js
        barba.init({
          // Configuração mais robusta para interceptar links
          prevent: ({ el }) => {
            // Não intercepta links externos ou com target="_blank"
            return el.getAttribute('target') === '_blank' || 
                   el.getAttribute('href').startsWith('http') ||
                   el.getAttribute('href').startsWith('mailto:');
          },
          
          transitions: [{
            name: 'instant-transition',
            leave(data) {
              // Armazena a página atual antes de sair
              sessionStorage.setItem('previousPage', data.current.url.path);
              
              // Sem transição - instantâneo
              return Promise.resolve();
            },
            enter(data) {
              // Processamento imediato sem delays
              // Garante que o DOM esteja pronto antes de processar
              setTimeout(() => {
                processInlineCode();
                setupBackLink();
              }, 0);
              
              // Resolve instantaneamente
              return Promise.resolve();
            },
            after(data) {
              // Garantia adicional de processamento após a transição
              processInlineCode();
            }
          }]
        });
        
      });
    </script>
  </head>

  <body class="dark:text-white font-serif" style="background-color: #1c1c1c;">
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-blue-600 text-white px-4 py-2 rounded z-50">Pular para o conteúdo principal</a>
    
    <!-- Header with site banner -->
    <header class="w-full" role="banner">
      <div class="w-10/12 max-w-screen-sm md:max-w-screen-md mx-auto">
        <img src="/assets/img/top-img.webp" 
             alt="Imagem de cabeçalho do blog do Matheus Gomes - desenvolvedor de software"
             class="blog-header-image"
             loading="eager"
             fetchpriority="high"
             width="672"
             height="123"
             style="height: 123px; width: 100%; object-fit: cover; 
                    background-color: #2d3748; 
                    background-position: center; 
                    background-size: 100% auto;
                    opacity: 1;
                    transition: opacity 0.1s ease-out;">
      </div>
    </header>
    
    <div data-barba="wrapper">
      <div data-barba="container">
        <main id="main-content" role="main">
          {{ content }}
        </main>
      </div>
    </div>
    
  </body>
</html>