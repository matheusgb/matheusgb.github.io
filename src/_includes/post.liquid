---
layout: main
---

{% include "nav.liquid" %}

<div class="py-4">
  <p class="mb-1">
    <span class="text-5xl md:text-6xl font-black text-white leading-tight">{{ title}}</span>
  </p>
  
  <em class="text-base text-gray-300 block mb-4">{{ date | dateDisplay }}</em>
  
  {% if tags %}
    <div class="flex flex-wrap gap-2 mb-6">
      {% for tag in tags %}
        {% unless tag == "posts" %}
          <a href="/topicos/{{ tag | downcase }}" 
             class="inline-block bg-gray-700 text-gray-300 px-3 py-1 rounded-full text-sm hover:bg-gray-600 transition-colors">
            {{ tag }}
          </a>
        {% endunless %}
      {% endfor %}
    </div>
  {% endif %}
  
  <div class="prose prose-lg dark:prose-invert">
    {{ content }}
  </div>
</div>